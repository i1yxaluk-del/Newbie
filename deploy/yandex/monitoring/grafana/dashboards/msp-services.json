{
  "uid": "msp-services",
  "title": "1.3 Сервисы",
  "tags": ["mspshield", "services", "level-1.3"],
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "60s",
  "timezone": "browser",
  "graphTooltip": 1,
  "links": [
    {
      "title": "← MSP Overview",
      "url": "/d/mspshield-overview",
      "type": "link",
      "icon": "arrow-left",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Vaultwarden",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-internal\",instance=\"http://vaultwarden:80\"}",
          "legendFormat": "Vaultwarden",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Grafana",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-internal\",instance=\"http://grafana:3000/api/health\"}",
          "legendFormat": "Grafana",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Stalwart SMTP",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "red" }, "1": { "text": "OPEN", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-smtp\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Stalwart IMAP",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "red" }, "1": { "text": "OPEN", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-imap\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Время ответа сервисов",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 3, "w": 12, "h": 7 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=~\"blackbox-http|blackbox-internal\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "SSL сертификат (дней до истечения)",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 3, "w": 12, "h": 7 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "min": 0,
          "max": 90,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 7 },
              { "color": "yellow", "value": 14 },
              { "color": "green", "value": 30 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-https-strict\"} - time()) / 86400",
          "legendFormat": "SSL msp-claude.online",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Backend — лиды и отказы",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 6 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "rejected/s" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "rate(mspshield_leads_total[5m])",
          "legendFormat": "leads/s",
          "refId": "A"
        },
        {
          "expr": "rate(mspshield_leads_rejected_total[5m])",
          "legendFormat": "rejected/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Uptime сервисов (24ч)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 6 },
      "options": {
        "reduceOptions": { "calcs": ["mean"] },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.95 },
              { "color": "yellow", "value": 0.99 },
              { "color": "green", "value": 0.999 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "avg_over_time(probe_success{job=\"blackbox-http\",instance=\"https://msp-claude.online\"}[24h])",
          "legendFormat": "Landing",
          "refId": "A"
        },
        {
          "expr": "avg_over_time(probe_success{job=\"blackbox-internal\",instance=\"http://vaultwarden:80\"}[24h])",
          "legendFormat": "Vaultwarden",
          "refId": "B"
        },
        {
          "expr": "avg_over_time(probe_success{job=\"blackbox-internal\",instance=\"http://grafana:3000/api/health\"}[24h])",
          "legendFormat": "Grafana",
          "refId": "C"
        }
      ]
    }
  ],
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "editable": true,
  "id": null
}
