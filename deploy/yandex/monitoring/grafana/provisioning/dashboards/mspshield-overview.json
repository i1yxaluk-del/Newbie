{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Site Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "probe_success{job=\"blackbox-http\",instance=\"https://msp-claude.online\"}", "legendFormat": "Landing", "refId": "A" },
        { "expr": "probe_success{job=\"blackbox-http\",instance=\"https://msp-claude.online/api/health\"}", "legendFormat": "API", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "#a13030" }, "1": { "text": "UP", "color": "#1b4d3e" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "#a13030" }, { "value": 1, "color": "#1b4d3e" }] },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "title": "SSL Expiry (days)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-https-strict\"} - time()) / 86400", "legendFormat": "{{ instance }}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "#a13030" }, { "value": 7, "color": "#b45309" }, { "value": 14, "color": "#5fc9a2" }, { "value": 30, "color": "#1b4d3e" }] },
          "min": 0, "max": 90,
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "title": "SMTP Ports",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "probe_success{job=\"blackbox-smtp\"}", "legendFormat": "{{ instance }}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "#a13030" }, "1": { "text": "OPEN", "color": "#1b4d3e" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "#a13030" }, { "value": 1, "color": "#1b4d3e" }] }
        }
      }
    },
    {
      "title": "Docker Containers",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "count(container_start_time_seconds{id!=\"/\"})", "legendFormat": "Running", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "#1b4d3e" }] },
          "color": { "mode": "fixed", "fixedColor": "#1b4d3e" }
        }
      }
    },
    {
      "title": "Response Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "probe_duration_seconds{job=\"blackbox-http\"}", "legendFormat": "{{ instance }}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "color": { "mode": "fixed", "fixedColor": "#5fc9a2" }
        },
        "overrides": [{ "match": { "fieldName": "Landing" }, "properties": [{ "id": "color", "value": { "fixedColor": "#1b4d3e" } }] }]
      }
    },
    {
      "title": "CPU Usage %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "custom": { "fillOpacity": 20, "lineWidth": 2 }, "color": { "mode": "fixed", "fixedColor": "#1b4d3e" } } }
    },
    {
      "title": "Memory Usage %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "Memory", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "custom": { "fillOpacity": 20, "lineWidth": 2 }, "color": { "mode": "fixed", "fixedColor": "#5fc9a2" } } }
    },
    {
      "title": "Disk Usage %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100", "legendFormat": "Disk /", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "custom": { "fillOpacity": 20, "lineWidth": 2 }, "color": { "mode": "fixed", "fixedColor": "#b45309" } } }
    },
    {
      "title": "Container Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "container_memory_usage_bytes{id!=\"/\"}", "legendFormat": "{{ name }}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 20, "lineWidth": 2 }, "color": { "mode": "palette-classic" } } }
    },
    {
      "title": "Container CPU %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "rate(container_cpu_usage_seconds_total{id!=\"/\"}[5m]) * 100", "legendFormat": "{{ name }}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "fillOpacity": 20, "lineWidth": 2 }, "color": { "mode": "palette-classic" } } }
    },
    {
      "title": "Network I/O",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{device=\"eth0\"}[5m])", "legendFormat": "RX", "refId": "A" },
        { "expr": "rate(node_network_transmit_bytes_total{device=\"eth0\"}[5m])", "legendFormat": "TX", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "fillOpacity": 20, "lineWidth": 2 } },
        "overrides": [
          { "match": { "fieldName": "RX" }, "properties": [{ "id": "color", "value": { "fixedColor": "#1b4d3e" } }] },
          { "match": { "fieldName": "TX" }, "properties": [{ "id": "color", "value": { "fixedColor": "#5fc9a2" } }] }
        ]
      }
    },
    {
      "title": "Leads Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "expr": "rate(mspshield_leads_total[5m])", "legendFormat": "leads/s", "refId": "A" },
        { "expr": "rate(mspshield_leads_rejected_total[5m])", "legendFormat": "rejected/s", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 20, "lineWidth": 2 } },
        "overrides": [
          { "match": { "fieldName": "leads/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "#1b4d3e" } }] },
          { "match": { "fieldName": "rejected/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "#b45309" } }] }
        ]
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["mspshield", "overview"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "MSPShield Overview",
  "uid": "mspshield-overview",
  "version": 6
}
