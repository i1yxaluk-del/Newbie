{{ define "mspshield.subject" }}
[{{ .Status | toUpper }}] {{ range .Alerts }}{{ .Labels.severity }} · {{ .Annotations.summary }}{{ end }}
{{ end }}

{{ define "mspshield.alert.text" }}
MSPShield · alert · prod
================================
{{ range .Alerts }}{{ .Labels.severity }} · {{ .Annotations.summary }}
  host:    {{ .Annotations.host }}
  severity: {{ .Labels.severity }}
  metric:  {{ .Annotations.metric }}
  runbook: {{ .Annotations.runbook }}
  started: {{ .StartsAt.Format "02 Jan 15:04 MST" }}
--------------------------------
{{ end }}
Grafana: https://grafana.msp-claude.online
Site:    https://msp-claude.online
{{ end }}

{{ define "mspshield.alert.html" }}
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0;padding:0;background-color:#f7f4ee;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#1a1815;">
<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f7f4ee;min-height:100vh;">
<tr><td align="center" style="padding:32px 16px;">
<table width="600" cellpadding="0" cellspacing="0" style="max-width:600px;">

<tr><td style="padding:0 0 24px 0;border-bottom:2px solid {{ if eq .Status "firing" }}#b91c1c{{ else }}#1b4d3e{{ end }};">
<span style="font-size:24px;font-weight:700;color:#1b4d3e;letter-spacing:-0.5px;">MSPShield</span>
<span style="font-size:13px;color:#78746a;margin-left:8px;">monitoring · prod</span>
</td></tr>

{{ range .Alerts }}
<tr><td style="padding:20px 0 12px 0;">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;border:1px solid #d4d0c8;border-radius:8px;">
<tr><td style="padding:20px;">

{{ if eq .Labels.severity "P1" }}
<table cellpadding="0" cellspacing="0"><tr><td style="background:#fef2f2;color:#991b1b;font-size:11px;font-weight:700;padding:3px 8px;border-radius:3px;">P1 · CRITICAL</td></tr></table>
{{ else if eq .Labels.severity "P2" }}
<table cellpadding="0" cellspacing="0"><tr><td style="background:#fffbeb;color:#92400e;font-size:11px;font-weight:700;padding:3px 8px;border-radius:3px;">P2 · WARNING</td></tr></table>
{{ else }}
<table cellpadding="0" cellspacing="0"><tr><td style="background:#f0fdf4;color:#166534;font-size:11px;font-weight:700;padding:3px 8px;border-radius:3px;">P3 · INFO</td></tr></table>
{{ end }}

<p style="font-size:15px;font-weight:600;color:#1a1815;margin:14px 0 6px 0;line-height:1.4;">
{{ .Annotations.summary }}
</p>

<table width="100%" cellpadding="0" cellspacing="0" style="font-size:12px;color:#78746a;margin-top:10px;">
{{ if .Annotations.host }}<tr><td style="padding:3px 0;color:#a3a090;width:80px;vertical-align:top;">host:</td><td style="padding:3px 0;color:#1a1815;">{{ .Annotations.host }}</td></tr>{{ end }}
<tr><td style="padding:3px 0;color:#a3a090;vertical-align:top;">severity:</td><td style="padding:3px 0;color:#1a1815;">{{ .Labels.severity }}</td></tr>
{{ if .Annotations.metric }}<tr><td style="padding:3px 0;color:#a3a090;vertical-align:top;">metric:</td><td style="padding:3px 0;color:#1a1815;font-family:monospace;font-size:11px;">{{ .Annotations.metric }}</td></tr>{{ end }}
{{ if .Annotations.runbook }}<tr><td style="padding:3px 0;color:#a3a090;vertical-align:top;">runbook:</td><td style="padding:3px 0;"><a href="{{ .Annotations.runbook }}" style="color:#1b4d3e;text-decoration:none;">{{ .Annotations.runbook }}</a></td></tr>{{ end }}
<tr><td style="padding:3px 0;color:#a3a090;vertical-align:top;">started:</td><td style="padding:3px 0;color:#1a1815;">{{ .StartsAt.Format "02 Jan 15:04 MST" }}</td></tr>
</table>

</td></tr>
</table>
</td></tr>
{{ end }}

<tr><td style="padding:20px 0 0 0;border-top:1px solid #d4d0c8;margin-top:8px;">
<table width="100%" cellpadding="0" cellspacing="0">
<tr>
<td style="font-size:11px;color:#a3a090;">
MSPShield Monitoring · <a href="https://msp-claude.online" style="color:#78746a;text-decoration:none;">msp-claude.online</a>
</td>
<td align="right" style="font-size:11px;">
<a href="https://mon.msp-claude.online" style="color:#78746a;text-decoration:none;">Grafana</a>
</td>
</tr>
</table>
</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
{{ end }}
