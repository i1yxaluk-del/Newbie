# ──────────────────────────────────────────────────────────────
# Dockerfile.frontend — React 19 SPA → nginx static
# ──────────────────────────────────────────────────────────────
# RU: Сборка лендинга в 2 стадии:
#   1. node:20-alpine  — yarn build → /app/build (статика).
#   2. nginx:1.27-alpine — раздаёт статику + SPA-fallback на index.html.
# Внутри контейнера nginx слушает :80. Наружу публикуется через
# внешний nginx reverse-proxy (см. deploy/nginx/mspshield.conf).
# В production это не основной путь — на продакшене собираем
# статику отдельно и кладём в /var/www/mspshield. Этот образ —
# для локального docker compose.
# ──────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile
COPY . .
RUN yarn build

FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
# Минимальный конфиг для dev-контейнера. В проде nginx-конфиг —
# deploy/nginx/mspshield.conf с SSL, CSP и rate-limit.
COPY <<'CONF' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;
    location / {
        try_files $uri /index.html;
    }
}
CONF
