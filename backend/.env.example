# ═══════════════════════════════════════════════════════════════════
# MSPShield backend · .env.example
# ═══════════════════════════════════════════════════════════════════
# Скопируй в backend/.env и заполни значения под свою среду.
# Локально:  `cp backend/.env.example backend/.env`
# В проде :  секреты берутся из Vaultwarden / секрет-хранилища,
#            НЕ коммитить реальный .env в git (он в .gitignore).
# ═══════════════════════════════════════════════════════════════════

# --- MongoDB --------------------------------------------------------
# URL подключения к Mongo. Локально = docker-контейнер mspshield-mongo.
# В проде = URI с авторизацией, ограниченной по IP в security group.
MONGO_URL=mongodb://localhost:27017

# Имя БД. В dev/test: mspshield_dev. В проде: mspshield.
# ВАЖНО: смена имени = смена данных (существующие лиды не мигрируют автоматически).
DB_NAME=mspshield_dev

# --- Admin API ------------------------------------------------------
# Токен для /api/leads, /api/leads/{id}/status, /api/stats.
#
# ВАЖНО: значение ниже — ТОЛЬКО для локального docker-compose (dev).
# НА ПРОДЕ ОБЯЗАТЕЛЬНО замени на уникальный:
#     ADMIN_TOKEN=$(openssl rand -hex 32)
# Иначе вход в /admin/leads будет ломаться по двум сценариям:
#   • токен пуст  → backend отвечает 503 "Admin access not configured"
#   • токен общеизвестный → любой читает заявки клиентов (утечка ПД)
# Сам токен храни в Vaultwarden → коллекция `MSPShield / Infra`.
ADMIN_TOKEN=dev-admin-token-local-testing-only

# --- Telegram уведомления о новых лидах ----------------------------
# Оставь пустыми локально — тогда уведомления не отправляются.
# В проде: создать бота через @BotFather, узнать chat_id через @getmyid_bot.
TG_BOT_TOKEN=
TG_CHAT_ID=

# --- CORS -----------------------------------------------------------
# Список origin'ов через запятую. Локально = CRA dev-сервер.
# В проде = https://mspshield.ru (без trailing slash).
CORS_ORIGINS=http://localhost:3000

# --- Rate limit -----------------------------------------------------
# Сколько заявок с одного IP допускается в окне RATE_LIMIT_WINDOW_SEC.
# Значения ниже = защита от спама. Повысить если фронт делает ретраи.
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_WINDOW_SEC=60

# --- Yandex SmartCaptcha (опционально) ------------------------------
# Оставь пустым в dev — сервер пропустит форму без проверки капчи.
# В проде: зарегистрировать сайт на https://cloud.yandex.ru/services/smartcaptcha,
# скопировать серверный ключ сюда (SMARTCAPTCHA_SERVER_KEY),
# клиентский ключ — в frontend/.env как REACT_APP_SMARTCAPTCHA_SITE_KEY.
SMARTCAPTCHA_SERVER_KEY=
SMARTCAPTCHA_VERIFY_URL=https://smartcaptcha.yandexcloud.net/validate
