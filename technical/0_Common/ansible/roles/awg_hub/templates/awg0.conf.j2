[Interface]
Address    = {{ awg_hub_address }}
ListenPort = {{ awg_hub_listen_port }}
PrivateKey = {{ awg_hub_private_key }}

# AmneziaWG обфускация — общий профиль для всех peers.
# Эти значения ДОЛЖНЫ совпадать на сервере и всех клиентских конфигах.
Jc   = {{ awg_hub_jc }}
Jmin = {{ awg_hub_jmin }}
Jmax = {{ awg_hub_jmax }}
S1   = {{ awg_hub_s1 }}
S2   = {{ awg_hub_s2 }}
H1   = {{ awg_hub_h1 }}
H2   = {{ awg_hub_h2 }}
H3   = {{ awg_hub_h3 }}
H4   = {{ awg_hub_h4 }}

# NAT: tenant → external via dynamically detected main interface
PostUp = iptables -A FORWARD -i {{ awg_hub_interface }} -j ACCEPT; iptables -A FORWARD -o {{ awg_hub_interface }} -j ACCEPT; iptables -t nat -A POSTROUTING -o {{ awg_hub_main_iface | default('eth0') }} -j MASQUERADE
PostDown = iptables -D FORWARD -i {{ awg_hub_interface }} -j ACCEPT; iptables -D FORWARD -o {{ awg_hub_interface }} -j ACCEPT; iptables -t nat -D POSTROUTING -o {{ awg_hub_main_iface | default('eth0') }} -j MASQUERADE

{% for peer in awg_hub_peers %}
# ── peer: {{ peer.name }} ──
[Peer]
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.allowed_ips }}

{% endfor %}
