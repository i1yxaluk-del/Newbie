# ═══════════════════════════════════════════════════════════════════
# alertmanager.yml — rendered by Ansible role `alertmanager` (K2 fix)
# ═══════════════════════════════════════════════════════════════════
# Исходник:          roles/alertmanager/templates/alertmanager.yml.j2
# Документация:      roles/alertmanager/README.md
# Vault (секреты):   group_vars/landing/vault.yml  (ansible-vault)
#
# Поля `chat_id` подставляются из vault, никаких `0`-плейсхолдеров
# в отличие от прежнего `technical/0_Common/monitoring/alertmanager.yml`.
# ═══════════════════════════════════════════════════════════════════

global:
  resolve_timeout: {{ alertmanager_resolve_timeout }}
  smtp_smarthost: "{{ alertmanager_smtp_smarthost }}"
  smtp_from: "{{ alertmanager_smtp_from }}"
  smtp_auth_username: "{{ alertmanager_smtp_user }}"
  smtp_auth_password_file: /etc/alertmanager/smtp_password
  smtp_require_tls: true

templates:
  - /etc/alertmanager/templates/*.tmpl

route:
  receiver: telegram
  group_by: [alertname, tenant, instance]
  group_wait: 30s
  group_interval: 2m
  repeat_interval: 4h
  routes:
    - match:
        severity: P1
      receiver: telegram_p1
      group_wait: 10s
      repeat_interval: 1h
      continue: true
    - match:
        severity: P2
      receiver: telegram
      group_wait: 1m
      repeat_interval: 4h
    - match:
        severity: P3
      receiver: email_warning
      group_wait: 1m
      group_interval: 5m
      repeat_interval: 12h
    - match:
        category: backup
      receiver: telegram_backup
      group_wait: 30s
      repeat_interval: 12h
    - match:
        category: sla
      receiver: telegram_p1
      group_wait: 0s
      repeat_interval: 30m

receivers:
  - name: telegram
    telegram_configs:
      - api_url: https://api.telegram.org
        bot_token_file: /etc/alertmanager/tg_bot_token
        chat_id: {{ alertmanager_tg_chat_id_general }}
        parse_mode: HTML

  - name: telegram_p1
    telegram_configs:
      - api_url: https://api.telegram.org
        bot_token_file: /etc/alertmanager/tg_bot_token
        chat_id: {{ alertmanager_tg_chat_id_p1 }}
        parse_mode: HTML
        send_resolved: true

  - name: telegram_backup
    telegram_configs:
      - api_url: https://api.telegram.org
        bot_token_file: /etc/alertmanager/tg_bot_token
        chat_id: {{ alertmanager_tg_chat_id_backup }}
        parse_mode: HTML
        send_resolved: true

  - name: email_warning
    email_configs:
      - to: {{ alertmanager_email_p3_to }}
        send_resolved: true
        headers:
          Subject: "[MSPShield P3] {% raw %}{{ .GroupLabels.alertname }} · {{ .GroupLabels.tenant }}{% endraw %}"

inhibit_rules:
  - source_match:
      severity: P1
    target_match:
      severity: P2
    equal: [tenant, alertname]
  - source_match:
      severity: P1
    target_match:
      severity: P3
    equal: [tenant, alertname]
