FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

EXPOSE 8001
HEALTHCHECK --interval=20s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:8001/api/health || exit 1

# One worker is intentional for the pilot: the in-process outbox poller must
# have a single owner. Move to a separately deployed worker before scaling out.
CMD ["uvicorn", "secure_server:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
