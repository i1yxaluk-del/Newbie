# ──────────────────────────────────────────────────────────────
# technical/0_Common/docker/.env.example
# RU: Переменные окружения для monitoring-стека (Prometheus+Grafana+…)
# Скопировать → .env, заполнить, НЕ коммитить .env в git.
# ──────────────────────────────────────────────────────────────

# Версии образов (можно не трогать — есть разумные дефолты)
PROMETHEUS_VERSION=v2.51.0
ALERTMANAGER_VERSION=v0.27.0
GRAFANA_VERSION=10.4.2
NODE_EXPORTER_VERSION=v1.7.0
CADVISOR_VERSION=v0.49.1
BLACKBOX_VERSION=v0.24.0
LOKI_VERSION=3.0.0

# Обязательно задать — иначе compose не стартует
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
