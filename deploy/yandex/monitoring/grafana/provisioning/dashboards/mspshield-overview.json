{
"uid": "msp-overview",
"title": "1. MSP Overview",
"tags": ["mspshield", "overview", "level-1"],
"schemaVersion": 39,
"version": 1,
"time": { "from": "now-1h", "to": "now" },
"refresh": "60s",
"timezone": "browser",
"graphTooltip": 1,
"links": [
  {
    "title": "1.1 Контейнеры",
    "url": "/d/msp-containers",
    "type": "link",
    "icon": "external link",
    "targetBlank": false
  },
  {
    "title": "1.2 VM Ресурсы",
    "url": "/d/msp-vm",
    "type": "link",
    "icon": "external link",
    "targetBlank": false
  },
  {
    "title": "1.3 Сервисы",
    "url": "/d/msp-services",
    "type": "link",
    "icon": "external link",
    "targetBlank": false
  }
],
"panels": [
  {
    "id": 1,
    "title": "Сайт",
    "type": "stat",
    "gridPos": { "x": 0, "y": 0, "w": 4, "h": 3 },
    "options": {
      "reduceOptions": { "calcs": ["lastNotNull"] },
      "orientation": "horizontal",
      "textMode": "auto",
      "colorMode": "background",
      "graphMode": "none"
    },
    "fieldConfig": {
      "defaults": {
        "mappings": [
          { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
        ],
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
        "color": { "mode": "thresholds" }
      }
    },
    "targets": [
      {
        "expr": "probe_success{job=\"blackbox-http\",instance=\"https://msp-claude.online\"}",
        "legendFormat": "Landing",
        "refId": "A"
      },
      {
        "expr": "probe_success{job=\"blackbox-http\",instance=\"https://msp-claude.online/api/health\"}",
        "legendFormat": "API",
        "refId": "B"
      }
    ]
  },
  {
    "id": 2,
    "title": "SSL (дней)",
    "type": "gauge",
    "gridPos": { "x": 4, "y": 0, "w": 4, "h": 3 },
    "options": {
      "reduceOptions": { "calcs": ["lastNotNull"] },
      "orientation": "auto",
      "showThresholdLabels": false,
      "showThresholdMarkers": true
    },
    "fieldConfig": {
      "defaults": {
        "unit": "d",
        "min": 0,
        "max": 90,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 7 },
            { "color": "yellow", "value": 14 },
            { "color": "green", "value": 30 }
          ]
        },
        "color": { "mode": "thresholds" }
      }
    },
    "targets": [
      {
        "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-https-strict\"} - time()) / 86400",
        "legendFormat": "SSL",
        "refId": "A"
      }
    ]
  },
  {
    "id": 3,
    "title": "SMTP порты",
    "type": "stat",
    "gridPos": { "x": 8, "y": 0, "w": 4, "h": 3 },
    "options": {
      "reduceOptions": { "calcs": ["lastNotNull"] },
      "orientation": "horizontal",
      "textMode": "auto",
      "colorMode": "background",
      "graphMode": "none"
    },
    "fieldConfig": {
      "defaults": {
        "mappings": [
          { "type": "value", "options": { "0": { "text": "CLOSED", "color": "red" }, "1": { "text": "OPEN", "color": "green" } } }
        ],
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
        "color": { "mode": "thresholds" }
      }
    },
    "targets": [
      {
        "expr": "probe_success{job=\"blackbox-smtp\"}",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }
    ]
  },
  {
    "id": 4,
    "title": "Контейнеры",
    "type": "stat",
    "gridPos": { "x": 12, "y": 0, "w": 3, "h": 3 },
    "options": {
      "reduceOptions": { "calcs": ["lastNotNull"] },
      "orientation": "auto",
      "textMode": "auto",
      "colorMode": "value",
      "graphMode": "none"
    },
    "fieldConfig": {
      "defaults": {
        "color": { "mode": "fixed", "fixedColor": "green" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
      }
    },
    "targets": [
      {
        "expr": "count(container_last_seen{name=~\".+\"})",
        "legendFormat": "Running",
        "refId": "A"
      }
    ]
  },
  {
    "id": 5,
    "title": "CPU VM",
    "type": "stat",
    "gridPos": { "x": 15, "y": 0, "w": 3, "h": 3 },
    "options": {
      "reduceOptions": { "calcs": ["lastNotNull"] },
      "orientation": "auto",
      "textMode": "auto",
      "colorMode": "background",
      "graphMode": "none"
    },
    "fieldConfig": {
      "defaults": {
        "unit": "percent",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 70 },
            { "color": "red", "value": 90 }
          ]
        },
        "color": { "mode": "thresholds" }
      }
    },
    "targets": [
      {
        "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
        "legendFormat": "CPU %",
        "refId": "A"
      }
    ]
  },
  {
    "id": 6,
    "title": "RAM VM",
    "type": "stat",
    "gridPos": { "x": 18, "y": 0, "w": 3, "h": 3 },
    "options": {
      "reduceOptions": { "calcs": ["lastNotNull"] },
      "orientation": "auto",
      "textMode": "auto",
      "colorMode": "background",
      "graphMode": "none"
    },
    "fieldConfig": {
      "defaults": {
        "unit": "percent",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 75 },
            { "color": "red", "value": 90 }
          ]
        },
        "color": { "mode": "thresholds" }
      }
    },
    "targets": [
      {
        "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
        "legendFormat": "RAM %",
        "refId": "A"
      }
    ]
  },
  {
    "id": 7,
    "title": "Disk VM",
    "type": "stat",
    "gridPos": { "x": 21, "y": 0, "w": 3, "h": 3 },
    "options": {
      "reduceOptions": { "calcs": ["lastNotNull"] },
      "orientation": "auto",
      "textMode": "auto",
      "colorMode": "background",
      "graphMode": "none"
    },
    "fieldConfig": {
      "defaults": {
        "unit": "percent",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 70 },
            { "color": "red", "value": 85 }
          ]
        },
        "color": { "mode": "thresholds" }
      }
    },
    "targets": [
      {
        "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
        "legendFormat": "Disk %",
        "refId": "A"
      }
    ]
  },
  {
    "id": 8,
    "title": "Время ответа сайта",
    "type": "timeseries",
    "gridPos": { "x": 0, "y": 3, "w": 12, "h": 6 },
    "options": {
      "tooltip": { "mode": "multi" },
      "legend": { "displayMode": "list", "placement": "bottom" }
    },
    "fieldConfig": {
      "defaults": {
        "unit": "s",
        "custom": { "lineWidth": 2, "fillOpacity": 10 },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
      }
    },
    "targets": [
      {
        "expr": "probe_duration_seconds{job=\"blackbox-http\"}",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }
    ]
  },
  {
    "id": 9,
    "title": "Лиды (rate)",
    "type": "timeseries",
    "gridPos": { "x": 12, "y": 3, "w": 12, "h": 6 },
    "options": {
      "tooltip": { "mode": "multi" },
      "legend": { "displayMode": "list", "placement": "bottom" }
    },
    "fieldConfig": {
      "defaults": {
        "unit": "ops",
        "custom": { "lineWidth": 2, "fillOpacity": 10 }
      },
      "overrides": [
        {
          "matcher": { "id": "byName", "options": "rejected/s" },
          "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#b45309" } }]
        }
      ]
    },
    "targets": [
      {
        "expr": "rate(mspshield_leads_total[5m])",
        "legendFormat": "leads/s",
        "refId": "A"
      },
      {
        "expr": "rate(mspshield_leads_rejected_total[5m])",
        "legendFormat": "rejected/s",
        "refId": "B"
      }
    ]
  }
],
"annotations": { "list": [] },
"templating": { "list": [] },
"timepicker": {},
"fiscalYearStartMonth": 0,
"editable": true,
"id": null
}