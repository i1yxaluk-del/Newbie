server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: {{ monitoring_agent_loki_url }}

scrape_configs:
  - job_name: system
    static_configs:
      - targets: [localhost]
        labels:
          job: varlogs
          host: "{{ inventory_hostname }}"
          __path__: /var/log/{syslog,auth.log}

  - job_name: mspshield
    static_configs:
      - targets: [localhost]
        labels:
          job: mspshield
          host: "{{ inventory_hostname }}"
          __path__: /var/log/mspshield/*.log

{% for extra in monitoring_agent_extra_logs %}
  - job_name: {{ extra.name }}
    static_configs:
      - targets: [localhost]
        labels:
          job: {{ extra.name }}
          host: "{{ inventory_hostname }}"
          __path__: {{ extra.path }}
{% endfor %}
