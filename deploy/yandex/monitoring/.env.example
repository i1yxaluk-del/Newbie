GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Alertmanager secrets (Stalwart SMTP + webhook Bearer token)
SMTP_AUTH_PASSWORD=<stalwart-alert-smtp-password>
ALERTMANAGER_WEBHOOK_TOKEN=<backend-webhook-token>

# MAX alerter secrets
ALERTMANAGER_WEBHOOK_TOKEN=<backend-webhook-token>
TELEGRAM_BOT_TOKEN=<tg-bot-token>
TELEGRAM_CHAT_ID=<tg-chat-id>
ALERT_EMAIL_TO=ops@example.invalid
MAX_FAILURE_COOLDOWN=300

# SMTP (Yandex Postbox — for Grafana)
SMTP_HOST=postbox.cloud.yandex.net
SMTP_FROM=alert@msp-claude.online
SMTP_USER=<postbox-api-key-id>
SMTP_PASSWORD=<postbox-api-key-secret>
GF_SMTP_ENABLED=true
GF_SMTP_HOST=postbox.cloud.yandex.net:465
GF_SMTP_USER=<postbox-api-key-id>
GF_SMTP_PASSWORD=<postbox-api-key-secret>
GF_SMTP_FROM_ADDRESS=alert@msp-claude.online
GF_SMTP_FROM_NAME=MSPShield
GF_SMTP_SKIP_VERIFY=false
