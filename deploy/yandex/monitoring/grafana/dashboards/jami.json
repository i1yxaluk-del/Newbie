{
  "uid": "jami-overview",
  "title": "Jami: сервисы и нагрузка",
  "tags": ["mspshield", "jami"],
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "60s",
  "timezone": "browser",
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Пользователи JAMS",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 3 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "targets": [{ "expr": "jami_jams_users_total", "legendFormat": "users", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Устройств зарегистрировано",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 3 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "targets": [{ "expr": "jami_jams_devices_total", "legendFormat": "devices", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "TURN-сессии (клиенты онлайн)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 3 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "targets": [{ "expr": "jami_turn_sessions", "legendFormat": "turn", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Клиенты DHT Proxy",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 3 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "targets": [{ "expr": "jami_dht_proxy_clients", "legendFormat": "proxy", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Пиры DHT (good)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 3 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "targets": [{ "expr": "jami_dht_peers_good", "legendFormat": "peers", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Always-online daemon",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 3 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{ "expr": "jami_daemon_up", "legendFormat": "jamid", "refId": "A" }]
    },
    {
      "id": 10,
      "title": "Здоровье сервисов (HTTP health)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 3, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ],
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10, "showPoints": "never" }
        }
      },
      "targets": [
        { "expr": "jami_service_up", "legendFormat": "{{name}}", "refId": "A" },
        { "expr": "jami_jams_up", "legendFormat": "jams", "refId": "B" },
        { "expr": "jami_dht_up", "legendFormat": "dhtnode", "refId": "C" }
      ]
    },
    {
      "id": 11,
      "title": "Внешние Jami-endpoint (blackbox)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 3, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ],
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 0, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "expr": "probe_success{instance=~\"https://(m|names|invite|push|dht)\\\\.msp-claude\\\\.online.*\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Нагрузка: TURN-сессии и DHT Proxy клиенты",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 11, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 8, "showPoints": "never" } } },
      "targets": [
        { "expr": "jami_turn_sessions", "legendFormat": "TURN-сессии", "refId": "A" },
        { "expr": "jami_dht_proxy_clients", "legendFormat": "DHT Proxy клиенты", "refId": "B" }
      ]
    }
  ]
}
